SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

HUNTER_API_KEY=your-hunter-api-key
APOLLO_API_KEY=your-apollo-api-key
BRANDFETCH_API_KEY=your-brandfetch-api-key
SERPAPI_API_KEY=your-serpapi-api-key

ENVIRONMENT=development
LOG_LEVEL=INFO
EMAIL_VERIFICATION_PROVIDER=mock
EMAIL_VERIFICATION_BATCH_SIZE=50
EMAIL_VERIFICATION_MAX_CONCURRENCY=5
EMAIL_VERIFICATION_RETRY_COUNT=3
EMAIL_VERIFICATION_TIMEOUT=10.0
EMAIL_VERIFICATION_REQUESTS_PER_SECOND=20.0
EMAIL_VERIFICATION_BACKOFF_BASE=1.0
DOMAIN_RESOLUTION_CONCURRENCY=20
WORKER_COUNT=1
CSV_CHUNK_SIZE=500
DATABASE_BATCH_SIZE=500
REDIS_PIPELINE_SIZE=100
MAX_JOB_RETRIES=3
WORKER_HEARTBEAT_INTERVAL=5.0
JOB_CHECKPOINT_INTERVAL=500
MEMORY_WARNING_THRESHOLD_MB=512.0

# Redis Queue Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0
REDIS_SOCKET_TIMEOUT=5.0
REDIS_QUEUE_NAME=email_enrichment_jobs

# CORS Allowed Origins
CORS_ORIGINS=["*"]





