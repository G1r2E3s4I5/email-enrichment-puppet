# Email Enrichment Platform — Production Environment Configuration

ENVIRONMENT=production
LOG_LEVEL=INFO

# Supabase Production Database Credentials
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Redis Production Queue
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your-secure-redis-password
REDIS_DB=0

# Concurrency & Performance Tuning
DOMAIN_RESOLUTION_CONCURRENCY=20
EMAIL_VERIFICATION_BATCH_SIZE=50
EMAIL_VERIFICATION_MAX_CONCURRENCY=10
WORKER_COUNT=4

# Circuit Breaker Configuration
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_RESET_TIMEOUT=30.0
CIRCUIT_BREAKER_HALF_OPEN_REQUESTS=3

# External Provider API Keys
TAVILY_API_KEY=your-tavily-api-key
SERPAPI_API_KEY=your-serpapi-key
BRANDFETCH_API_KEY=your-brandfetch-key
OPENAI_API_KEY=your-openai-key
HUNTER_API_KEY=your-hunter-key
