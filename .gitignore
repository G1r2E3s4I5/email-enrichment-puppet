# Environment & Secrets
.env
.env.local
.env.*.local
*.env

# Bulk Processing Work Directories (Files ignored, gitkeeps tracked)
uploads/*
!uploads/.gitkeep
exports/*
!exports/.gitkeep
temp/*
!temp/.gitkeep

# Application & Worker Logs
logs/*
!logs/.gitkeep
backend/logs/*
!backend/logs/.gitkeep
*.log

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
venv/
.venv/
env/
ENV/
backend/venv/

# Testing & Coverage (Test fixtures MUST be tracked in git)
.pytest_cache/
.coverage
htmlcov/
.coverage.*

# Node.js & Frontend Build Outputs
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE & OS System Files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
